<!DOCTYPE html>
<html lang="ml">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouTube</title>
    <link rel="icon" href="https://upload.wikimedia.org/wikipedia/commons/e/ef/Youtube_logo.png">
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background-color: #f9f9f9; }
        header { background-color: white; padding: 10px 15px; display: flex; align-items: center; border-bottom: 1px solid #ddd; position: sticky; top: 0; z-index: 100; }
        .logo { color: #FF0000; font-weight: bold; font-size: 20px; display: flex; align-items: center; text-decoration: none; }
        .logo span { color: black; margin-left: 5px; }
        .video-container { display: grid; grid-template-columns: 1fr; gap: 15px; padding: 10px; }
        .video-card { background: white; border-radius: 8px; overflow: hidden; cursor: pointer; }
        .thumbnail { width: 100%; height: 200px; display: flex; justify-content: center; align-items: center; position: relative; background-color: #eee; }
        .thumbnail img { width: 100%; height: 100%; object-fit: cover; }
        .video-info { padding: 10px; }
        .video-title { font-weight: bold; font-size: 14px; }
        .play-btn { position: absolute; font-size: 40px; color: white; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <svg height="24" viewBox="0 0 24 24" width="24" fill="red"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            <span>YouTube</span>
        </div>
    </header>

    <div class="video-container">
        <div class="video-card" onclick="alert('കുട്ടികൾ ഫോണിൽ കളിക്കരുത്!'); playWarning();">
            <div class="thumbnail">
                <img src="https://img.freepik.com/free-vector/cute-tiger-playing-with-ball-cartoon-vector-icon-illustration_138676-5744.jpg" alt="Cartoon">
                <div class="play-btn">▶</div>
            </div>
            <div class="video-info"><div class="video-title">നിങ്ങൾക്കായി ഒരു കാർട്ടൂൺ!</div></div>
        </div>
    </div>

    <script>
        function playWarning() {
            const msg = new SpeechSynthesisUtterance();
            msg.text = "Kuttikal phonil kalikkaruthey";
            msg.lang = 'ml-IN';
            window.speechSynthesis.speak(msg);
        }
    </script>
</body>
</html>
